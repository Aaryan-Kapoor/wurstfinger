    "Hold a field to remove a standard symbol or bring it back.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte ein Feld gedrückt, um ein Standardsymbol zu entfernen oder wiederherzustellen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
