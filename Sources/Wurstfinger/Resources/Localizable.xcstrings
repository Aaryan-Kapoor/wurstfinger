    "This layout was made with a newer version of Wurstfinger. Update the app to use it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Layout wurde mit einer neueren Version von Wurstfinger erstellt. Aktualisiere die App, um es zu verwenden."
