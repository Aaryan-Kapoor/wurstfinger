    "A language code such as en or tr_TR decides how letters are capitalized.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Sprachcode wie en oder tr_TR legt fest, wie Buchstaben großgeschrieben werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un code de langue comme en ou tr_TR détermine la façon dont les lettres sont mises en majuscules."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un código de idioma como en o tr_TR determina cómo se ponen en mayúsculas las letras."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un codice lingua come en o tr_TR stabilisce come vengono scritte le maiuscole."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Код языка, например en или tr_TR, определяет, как буквы становятся заглавными."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod języka, np. en lub tr_TR, określa, jak zamieniane są wielkie litery."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En språkkod som en eller tr_TR avgör hur bokstäver blir versaler."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kielikoodi, kuten en tai tr_TR, määrää, miten kirjaimet muutetaan isoiksi."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod jezika poput en ili tr_TR određuje kako se slova pretvaraju u velika."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קוד שפה כמו en או tr_TR קובע כיצד אותיות הופכות לגדולות."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mã ngôn ngữ như en hoặc tr_TR quyết định cách viết hoa chữ cái."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang code ng wika tulad ng en o tr_TR ang nagpapasya kung paano gagawing malaki ang mga letra."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας κωδικός γλώσσας όπως en ή tr_TR καθορίζει πώς γίνονται κεφαλαία τα γράμματα."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um código de idioma como en ou tr_TR determina como as letras passam a maiúsculas."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Код мови, наприклад en або tr_TR, визначає, як літери стають великими."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رمز اللغة مثل en أو tr_TR يحدد كيفية تحويل الأحرف إلى كبيرة."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کد زبان مانند en یا tr_TR تعیین می‌کند حروف چگونه بزرگ شوند."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "en یا tr_TR جیسا زبان کا کوڈ طے کرتا ہے کہ حروف کیسے بڑے ہوں۔"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รหัสภาษา เช่น en หรือ tr_TR กำหนดวิธีเปลี่ยนตัวอักษรเป็นตัวพิมพ์ใหญ่"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "en या tr_TR जैसा भाषा कोड तय करता है कि अक्षर कैसे बड़े किए जाएँ।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "enやtr_TRなどの言語コードで、文字を大文字にする方法が決まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
