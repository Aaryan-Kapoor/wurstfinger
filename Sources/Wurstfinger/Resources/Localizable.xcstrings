        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แยกครึ่งบนหน้าจอกว้าง"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चौड़ी स्क्रीन पर बाँटें"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "広い画面で分割"
