    "Measured in key sizes: 1.5 means a swipe one and a half keys long.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Tastengrößen gemessen: 1.5 bedeutet eine Wischlänge von eineinhalb Tasten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesurée en tailles de touche : 1.5 correspond à un balayage d'une touche et demie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se mide en tamaños de tecla: 1.5 es un deslizamiento de una tecla y media."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Misurata in dimensioni del tasto: 1.5 indica uno scorrimento lungo un tasto e mezzo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Измеряется в размерах клавиши: 1.5 — это свайп длиной в полторы клавиши."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mierzona w rozmiarach klawisza: 1.5 oznacza przesunięcie o długości półtora klawisza."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mäts i tangentstorlekar: 1.5 betyder ett svep på en och en halv tangent."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitataan näppäinten kokoina: 1.5 tarkoittaa puolitoista näppäintä pitkää pyyhkäisyä."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mjeri se u veličinama tipke: 1.5 znači potez dug jednu i pol tipku."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נמדד בגודל מקשים: 1.5 פירושו החלקה באורך מקש וחצי."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đo theo kích thước phím: 1.5 nghĩa là vuốt dài một phím rưỡi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinusukat sa laki ng key: ang 1.5 ay swipe na isa't kalahating key ang haba."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετριέται σε μεγέθη πλήκτρου: το 1.5 σημαίνει σύρσιμο μήκους ενάμισι πλήκτρου."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Medida em tamanhos de tecla: 1.5 significa um deslize com uma tecla e meia de comprimento."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимірюється в розмірах клавіші: 1.5 — це свайп завдовжки півтори клавіші."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُقاس بحجم المفتاح: القيمة 1.5 تعني سحبة بطول مفتاح ونصف."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با اندازهٔ کلید سنجیده می‌شود: 1.5 یعنی کشیدنی به طول یک کلید و نیم."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کلید کے سائز میں ناپا جاتا ہے: 1.5 کا مطلب ڈیڑھ کلید لمبی سوائپ ہے۔"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วัดเป็นขนาดคีย์: 1.5 หมายถึงการปัดยาวหนึ่งคีย์ครึ่ง"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुंजी के आकार में मापा जाता है: 1.5 का मतलब डेढ़ कुंजी लंबा स्वाइप है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーサイズ単位で測ります。1.5は、キー1.5個分の長さのスワイプです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 크기 단위로 측정합니다. 1.5는 키 1.5개 길이의 스와이프를 뜻합니다."
          }
        }
      }
    },
