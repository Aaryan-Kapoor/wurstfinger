          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החזיקו שדה לחוץ כדי להסיר סמל רגיל או להחזיר אותו."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
