          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این چیدمان با نسخه جدیدتری از Wurstfinger ساخته شده است. برنامه را به‌روزرسانی کنید تا از آن استفاده کنید."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
