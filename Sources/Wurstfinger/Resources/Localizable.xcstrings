        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот файл слишком велик для раскладки клавиатуры."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten plik jest zbyt duży, by być układem klawiatury."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen är för stor för att vara en tangentbordslayout."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiedosto on liian suuri ollakseen näppäimistöasettelu."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova je datoteka prevelika da bi bila raspored tipkovnice."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקובץ גדול מדי מכדי להיות פריסת מקלדת."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp này quá lớn để là một bố cục bàn phím."
          }
        },
        "fil": {
