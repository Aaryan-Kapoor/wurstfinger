    "Tap a key to change what each swipe types.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf eine Taste, um zu ändern, was jede Wischgeste eingibt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez une touche pour modifier ce que chaque balayage saisit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una tecla para cambiar lo que escribe cada deslizamiento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un tasto per cambiare cosa digita ogni scorrimento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите клавишу, чтобы изменить, что вводит каждый свайп."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij klawisz, aby zmienić, co wpisuje każde przesunięcie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på en tangent för att ändra vad varje svep skriver."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta näppäintä muuttaaksesi, mitä kukin pyyhkäisy kirjoittaa."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirnite tipku da promijenite što upisuje svako povlačenje."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקישו על מקש כדי לשנות מה כל החלקה מקלידה."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào một phím để đổi nội dung nhập của từng thao tác vuốt."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-tap ang isang key para baguhin kung ano ang tina-type ng bawat swipe."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε ένα πλήκτρο για να αλλάξετε τι πληκτρολογεί κάθε σύρσιμο."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque numa tecla para alterar o que cada deslize escreve."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться клавіші, щоб змінити, що вводить кожен свайп."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على مفتاح لتغيير ما تكتبه كل حركة سحب."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روی یک کلید بزنید تا تغییر دهید هر کشیدن چه چیزی تایپ می‌کند."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کسی کلید پر تھپتھپائیں تاکہ ہر سوائپ کا ٹائپ کیا جانے والا متن بدل سکیں۔"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะปุ่มเพื่อเปลี่ยนสิ่งที่การปัดแต่ละทิศพิมพ์"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर स्वाइप क्या टाइप करे, यह बदलने के लिए किसी कुंजी पर टैप करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーをタップして、各スワイプで入力される内容を変更します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 탭하여 각 스와이프로 입력되는 내용을 바꿉니다."
          }
        }
      }
    },
