          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η διάταξη δημιουργήθηκε με νεότερη έκδοση του Wurstfinger. Ενημερώστε την εφαρμογή για να τη χρησιμοποιήσετε."
          }
        },
        "pt": {
