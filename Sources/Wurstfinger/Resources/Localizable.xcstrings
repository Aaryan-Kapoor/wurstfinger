    "Start from an existing layout and change any key, or import a layout file. Turn a custom layout on under Languages.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte mit einem vorhandenen Layout und ändere beliebige Tasten, oder importiere eine Layout-Datei. Aktiviere ein eigenes Layout unter „Sprachen“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partez d’une disposition existante et modifiez n’importe quelle touche, ou importez un fichier de disposition. Activez une disposition personnalisée dans Langues."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza con una disposición existente y cambia cualquier tecla, o importa un archivo de disposición. Activa una disposición personalizada en Idiomas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parti da un layout esistente e modifica qualsiasi tasto, oppure importa un file di layout. Attiva un layout personalizzato in Lingue."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начните с готовой раскладки и измените любую клавишу или импортируйте файл раскладки. Включите свою раскладку в разделе «Языки»."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacznij od istniejącego układu i zmień dowolny klawisz albo zaimportuj plik układu. Włącz własny układ w sekcji Języki."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utgå från en befintlig layout och ändra valfri tangent, eller importera en layoutfil. Aktivera en egen layout under Språk."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aloita olemassa olevasta asettelusta ja muuta mitä tahansa näppäintä tai tuo asettelutiedosto. Ota oma asettelu käyttöön kohdassa Kielet."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Krenite od postojećeg rasporeda i promijenite bilo koju tipku ili uvezite datoteku rasporeda. Vlastiti raspored uključite u Jezicima."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התחילו מפריסה קיימת ושנו כל מקש, או ייבאו קובץ פריסה. הפעילו פריסה מותאמת אישית תחת שפות."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu từ một bố cục có sẵn và thay đổi bất kỳ phím nào, hoặc nhập tệp bố cục. Bật bố cục tùy chỉnh trong Ngôn ngữ."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magsimula sa isang umiiral na layout at baguhin ang kahit anong key, o mag-import ng layout file. I-on ang custom na layout sa Mga Wika."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξεκινήστε από μια υπάρχουσα διάταξη και αλλάξτε οποιοδήποτε πλήκτρο ή εισαγάγετε ένα αρχείο διάταξης. Ενεργοποιήστε μια προσαρμοσμένη διάταξη στις Γλώσσες."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece com um esquema existente e altere qualquer tecla, ou importe um ficheiro de esquema. Ative um esquema personalizado em Idiomas."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Почніть із наявної розкладки й змініть будь-яку клавішу або імпортуйте файл розкладки. Увімкніть власну розкладку в розділі «Мови»."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ من تخطيط موجود وغيّر أي مفتاح، أو استورد ملف تخطيط. فعّل تخطيطًا مخصصًا من اللغات."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از یک چیدمان موجود شروع کنید و هر کلیدی را تغییر دهید، یا یک پرونده چیدمان وارد کنید. چیدمان سفارشی را در زبان‌ها روشن کنید."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کسی موجودہ لے آؤٹ سے شروع کریں اور کوئی بھی کلید بدلیں، یا لے آؤٹ فائل درآمد کریں۔ حسب ضرورت لے آؤٹ کو زبانیں میں آن کریں۔"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มจากเลย์เอาต์ที่มีอยู่แล้วแก้ไขปุ่มใดก็ได้ หรือนำเข้าไฟล์เลย์เอาต์ เปิดใช้เลย์เอาต์ที่กำหนดเองได้ในภาษา"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी मौजूदा लेआउट से शुरू करें और कोई भी कुंजी बदलें, या लेआउट फ़ाइल आयात करें। कस्टम लेआउट को भाषाएँ में चालू करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既存のレイアウトから始めて好きなキーを変更するか、レイアウトファイルを読み込みます。カスタムレイアウトは「言語」でオンにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기존 레이아웃에서 시작해 원하는 키를 바꾸거나 레이아웃 파일을 가져오세요. 사용자 레이아웃은 언어에서 켤 수 있습니다."
          }
        }
      }
    },
    "Some layout files could not be read and were skipped.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Layout-Dateien konnten nicht gelesen werden und wurden übersprungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains fichiers de disposition n’ont pas pu être lus et ont été ignorés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos archivos de disposición no se pudieron leer y se omitieron."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcuni file di layout non sono stati letti e sono stati ignorati."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые файлы раскладок не удалось прочитать, они пропущены."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niektórych plików układów nie udało się odczytać i zostały pominięte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vissa layoutfiler kunde inte läsas och hoppades över."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Joitakin asettelutiedostoja ei voitu lukea, ja ne ohitettiin."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neke datoteke rasporeda nije bilo moguće pročitati pa su preskočene."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לקרוא חלק מקובצי הפריסה והם דולגו."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một số tệp bố cục không đọc được và đã bị bỏ qua."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May ilang layout file na hindi nabasa at nilaktawan."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ορισμένα αρχεία διάταξης δεν μπόρεσαν να διαβαστούν και παραλείφθηκαν."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns ficheiros de esquema não puderam ser lidos e foram ignorados."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Деякі файли розкладок не вдалося прочитати, їх пропущено."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة بعض ملفات التخطيط فتم تخطيها."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برخی پرونده‌های چیدمان خوانده نشدند و نادیده گرفته شدند."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کچھ لے آؤٹ فائلیں پڑھی نہیں جا سکیں اور چھوڑ دی گئیں۔"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์เลย์เอาต์บางไฟล์อ่านไม่ได้และถูกข้ามไป"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ लेआउट फ़ाइलें पढ़ी नहीं जा सकीं और छोड़ दी गईं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込めなかったレイアウトファイルがあり、スキップされました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽을 수 없는 레이아웃 파일이 있어 건너뛰었습니다."
          }
        }
