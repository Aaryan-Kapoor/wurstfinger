    "Plays the keyboard click on every key, and stays silent in silent mode.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielt bei jeder Taste den Tastaturklick ab und bleibt im Stummmodus still."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joue le clic du clavier à chaque touche, et reste silencieux en mode silencieux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce el clic del teclado en cada tecla y permanece en silencio en el modo silencio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riproduce il clic della tastiera a ogni tasto e resta muto in modalità silenziosa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Воспроизводит щелчок клавиатуры на каждой клавише и молчит в бесшумном режиме."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odtwarza kliknięcie klawiatury przy każdym klawiszu i milknie w trybie cichym."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spelar tangentbordsklicket för varje tangent och är tyst i ljudlöst läge."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toistaa näppäimistön napsautuksen jokaisesta näppäimestä ja on hiljaa äänettömässä tilassa."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproducira klik tipkovnice na svakoj tipki i šuti u tihom načinu."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משמיע את צליל ההקלדה בכל מקש, ושותק במצב שקט."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phát tiếng bấm bàn phím ở mỗi phím và im lặng ở chế độ im lặng."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagpe-play ng click ng keyboard sa bawat key, at tahimik kapag naka-silent mode."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παίζει τον ήχο του πληκτρολογίου σε κάθε πλήκτρο και μένει σιωπηλό στην αθόρυβη λειτουργία."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduz o clique do teclado em cada tecla e fica em silêncio no modo silencioso."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відтворює клацання клавіатури на кожній клавіші й мовчить у безшумному режимі."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشغّل نقرة لوحة المفاتيح مع كل مفتاح، ويبقى صامتًا في الوضع الصامت."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "صدای کلیک صفحه‌کلید را برای هر کلید پخش می‌کند و در حالت بی‌صدا ساکت می‌ماند."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر کلید پر کی بورڈ کی کلک چلاتا ہے، اور خاموش موڈ میں خاموش رہتا ہے۔"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เล่นเสียงคลิกแป้นพิมพ์ทุกครั้งที่กดปุ่ม และเงียบเมื่ออยู่ในโหมดเงียบ"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर की पर कीबोर्ड क्लिक बजाता है, और साइलेंट मोड में चुप रहता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーを押すたびにキーボードのクリック音を鳴らします。消音モードでは鳴りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 누를 때마다 키보드 클릭 소리를 재생하며, 무음 모드에서는 소리가 나지 않습니다."
          }
        }
      }
    },
