          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll in ett fält för att ta bort en standardsymbol eller få tillbaka den."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä kenttää painettuna poistaaksesi vakiomerkin tai palauttaaksesi sen."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
