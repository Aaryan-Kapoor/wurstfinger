default_platform(:ios)

# Single CI predicate — GitHub Actions sets CI="true"; a bare truthy check
# would also fire on CI="false" or CI="".
def ci?
  ENV["CI"] == "true"
end

# Shared by create_keychain, match, the bundle script, and cleanup — a rename
# in one place without the others would silently break signing or cleanup.
CI_KEYCHAIN_NAME = "fastlane_tmp_keychain"
CI_KEYCHAIN_PASSWORD = "temp_password_123"

# The app is built by scripts/bundle-ios.sh (Swift Bundler plus our own
# keyboard-extension assembly), not by gym: there is no Xcode project anymore.
BUNDLE_SCRIPT = File.expand_path("../scripts/bundle-ios.sh", __dir__)
BUNDLER_TOML = File.expand_path("../Bundler.toml", __dir__)
IPA_PATH = File.expand_path("../build/Wurstfinger.ipa", __dir__)

# One scalar from the `[apps.Wurstfinger]` table of Bundler.toml, which is where
# the version and bundle identifier now live (they were Xcode build settings).
def bundler_app_value(key)
  in_table = false
  File.foreach(BUNDLER_TOML) do |line|
    if line =~ /\A\[/
      in_table = line.strip == "[apps.Wurstfinger]"
    elsif in_table && line =~ /\A#{Regexp.escape(key)}\s*=\s*"([^"]*)"/
      return Regexp.last_match(1)
    end
  end
  UI.user_error!("Bundler.toml has no `#{key}` under [apps.Wurstfinger]")
end

# match exports the installed profile's path as an environment variable.
def match_profile_path(app_id)
  path = ENV["sigh_#{app_id}_appstore_profile-path"]
  UI.user_error!("match did not report a provisioning profile for #{app_id}") if path.nil? || path.empty?
  path
end

platform :ios do
  # Shared context for both lanes: validated environment plus an ASC API key.
  private_lane :asc_context do
    app_id = ENV.fetch("APP_IDENTIFIER", "de.akator.wurstfinger")
    team_id = ENV.fetch("APPLE_TEAM_ID")

    UI.user_error!("APPLE_TEAM_ID is required but not set") if team_id.nil? || team_id.empty?

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: Base64.decode64(ENV.fetch("ASC_KEY_P8_BASE64")),
      duration: 1200,
      in_house: false
    )

    { app_id: app_id, api_key: api_key }
  end

  # Signs with match and builds the app-store ipa with scripts/bundle-ios.sh.
  # Shared verbatim between the beta and release lanes so signing or build
  # fixes cannot drift between them. Both targets (app and keyboard extension)
  # are signed by the script, each with its own match profile; the ipa lands
  # at IPA_PATH.
  private_lane :build_signed_ipa do |options|
    app_id = options[:app_id]

    # The bundle identifier is fixed in Bundler.toml; the profiles must match it.
    manifest_id = bundler_app_value("identifier")
    if app_id != manifest_id
      UI.user_error!("APP_IDENTIFIER (#{app_id}) differs from Bundler.toml's identifier (#{manifest_id})")
    end

    # Create temporary keychain for CI
    if ci?
      create_keychain(
        name: CI_KEYCHAIN_NAME,
        password: CI_KEYCHAIN_PASSWORD,
        default_keychain: true,
        unlock: true,
        timeout: 3600,
        lock_when_sleeps: false
      )
    end

    match(
      type: "appstore",
      readonly: ci?,
      app_identifier: [app_id, "#{app_id}.keyboard"],
      keychain_name: ci? ? CI_KEYCHAIN_NAME : "login.keychain",
      keychain_password: ci? ? CI_KEYCHAIN_PASSWORD : nil
    )

    FileUtils.mkdir_p(File.dirname(IPA_PATH))
    command = [
      BUNDLE_SCRIPT,
      "--device",
      "--configuration", "release",
      "--build-number", options[:build_number].to_s,
      # A substring is enough: it matches "Apple Distribution: ..." as well as the
      # legacy "iPhone Distribution: ..." certificates match may still hold.
      "--identity", ENV.fetch("CODE_SIGN_IDENTITY", "Distribution"),
      "--app-profile", match_profile_path(app_id),
      "--keyboard-profile", match_profile_path("#{app_id}.keyboard"),
      "--ipa", IPA_PATH
    ]
    command += ["--keychain", File.expand_path("~/Library/Keychains/#{CI_KEYCHAIN_NAME}-db")] if ci?
    sh(*command)

    IPA_PATH
  end

  private_lane :cleanup_ci_keychain do
    next unless ci?

    # Only delete when the keychain actually exists — the lane may fail
    # before create_keychain ran, and delete_keychain raises otherwise.
    keychain = CI_KEYCHAIN_NAME
    exists = ["#{keychain}-db", keychain].any? do |name|
      File.exist?(File.expand_path("~/Library/Keychains/#{name}"))
    end
    delete_keychain(name: keychain) if exists
  end

  # Runs after any lane failure. Without this, a failed match/build/upload
  # leaves fastlane_tmp_keychain in place *and* set as the default keychain
  # on the runner. Guarded so cleanup problems never mask the original error.
  error do |_lane, _exception|
    begin
      cleanup_ci_keychain
    rescue => cleanup_error
      UI.important("CI keychain cleanup failed: #{cleanup_error.message}")
    end
  end

  desc "Build & upload to TestFlight on develop merges"
  lane :beta do
    ctx = asc_context

    # Get latest build number from TestFlight and increment
    latest_build = latest_testflight_build_number(
      api_key: ctx[:api_key],
      app_identifier: ctx[:app_id]
    )

    build_number = latest_build + 1
    ipa = build_signed_ipa(app_id: ctx[:app_id], build_number: build_number)

    # The upload itself must fail the lane — a blanket rescue here once
    # masked App Store Connect rejecting every nightly binary while the
    # workflow stayed green.
    upload_to_testflight(
      api_key: ctx[:api_key],
      ipa: ipa,
      uses_non_exempt_encryption: false,
      changelog: ENV.fetch("CHANGELOG", "Automated build from develop.")
    )

    # External distribution and beta review submission are flaky on Apple's
    # side; the build is already uploaded, so tolerate failures here.
    begin
      upload_to_testflight(
        api_key: ctx[:api_key],
        distribute_only: true,
        build_number: build_number.to_s,
        groups: ["Internal", "Public Beta"],
        distribute_external: true,
        submit_beta_review: true,
        beta_app_review_info: {
          contact_email: ENV.fetch("BETA_CONTACT_EMAIL", "info@akator.de"),
          contact_first_name: ENV.fetch("BETA_CONTACT_FIRST_NAME", "Developer"),
          contact_last_name: ENV.fetch("BETA_CONTACT_LAST_NAME", "Akator"),
          contact_phone: ENV.fetch("BETA_CONTACT_PHONE", "+49 000 000000"),
          demo_account_required: false,
          notes: "MessagEase-inspired keyboard extension for iOS. Enable in Settings > General > Keyboard > Keyboards > Add New Keyboard."
        }
      )
    rescue => e
      UI.important "Beta distribution/review submission failed (build itself is uploaded): #{e.message}"
    end

    cleanup_ci_keychain
  end

  desc "Submit to App Store for review"
  lane :release do
    ctx = asc_context

    # Get latest build number from App Store and increment
    latest_build = app_store_build_number(
      api_key: ctx[:api_key],
      app_identifier: ctx[:app_id],
      live: false
    )

    ipa = build_signed_ipa(app_id: ctx[:app_id], build_number: latest_build + 1)

    # Read the version from Bundler.toml so deliver creates the correct App Store version
    version = bundler_app_value("version")

    # No `build_number:` here — that option tells deliver to select an
    # already-uploaded build and silently skips uploading the freshly built
    # ipa. With `ipa:` set, deliver uploads exactly that file.
    upload_to_app_store(
      api_key: ctx[:api_key],
      ipa: ipa,
      app_version: version,
      skip_metadata: false,
      skip_screenshots: false,
      screenshots_path: "./fastlane/screenshots",
      overwrite_screenshots: true,
      force: true,
      submit_for_review: false,
      precheck_include_in_app_purchases: false,
      app_review_information: {
        first_name: ENV.fetch("REVIEW_CONTACT_FIRST_NAME", ""),
        last_name: ENV.fetch("REVIEW_CONTACT_LAST_NAME", ""),
        email_address: ENV.fetch("REVIEW_CONTACT_EMAIL", ""),
        phone_number: ENV.fetch("REVIEW_CONTACT_PHONE", ""),
        demo_user: "",
        demo_password: "",
        notes: File.read("metadata/review_information/notes.txt")
      }
    )

    cleanup_ci_keychain
  end
end
